{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/handler.js": {
      "maxDuration": 60,
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/handler?action=health"
    },
    {
      "source": "/api/analyze",
      "destination": "/api/handler?action=analyze"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
